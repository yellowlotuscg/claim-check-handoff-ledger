# Optional local settings
HANDOFF_DATA_DIR=.handoff-ledger
HANDOFF_REPO_PATH=.
HANDOFF_DEFAULT_BRANCH=main

# Azure mode (managed identity / DefaultAzureCredential)
AZURE_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
AZURE_STORAGE_QUEUE_URL=https://<storage-account>.queue.core.windows.net/handoffs
AZURE_CLAIMCHECK_CONTAINER=claimchecks
AZURE_LEDGER_CONTAINER=ledger
